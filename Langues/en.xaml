    <!-- Notice -->
    <system:String x:Key="TxtNoticeHeader">USER GUIDE</system:String>
    <system:String x:Key="TxtNotice1Title">1. HOW IT WORKS</system:String>
    <system:String x:Key="TxtNotice1Desc">This application calculates Count Harebourg's confusion mechanic instantly and without errors. The overlay safely displays on top of your game (no screen reading).</system:String>
    <system:String x:Key="TxtNotice1IntroCardTitle">Overview</system:String>
    <system:String x:Key="TxtNotice1SafetyCardTitle">Safeguards</system:String>
    <system:String x:Key="TxtNotice1SafetyLine1">100% visual and manual calculation of the Count&apos;s mechanic.</system:String>
    <system:String x:Key="TxtNotice1SafetyLine2">No memory reading, no screen scanning, no automation.</system:String>
    <system:String x:Key="TxtNotice1SafetyLine3">The overlay stays click-through so you can keep playing normally.</system:String>
    <system:String x:Key="TxtNotice2Title">2. HOW TO USE</system:String>
    <system:String x:Key="TxtNotice2InputLine1">Paste 82% or a valid combat log line: FROST automatically sets the threshold and starting orientation.</system:String>
    <system:String x:Key="TxtNotice2InputLine2">The target type remains manual: you must choose Boss or Monster yourself.</system:String>
    <system:String x:Key="TxtNotice2InputLine3">The number of melee hits remains manual with the + / - buttons.</system:String>
    <system:String x:Key="TxtNotice3Title">3. ADVANCED MECHANICS</system:String>
    <system:String x:Key="TxtNotice3Desc">Gusset Effect (Boss):&#x0a;Odd Turn: YOU are teleported symmetrically to the Count.&#x0a;Even Turn: THE COUNT is teleported symmetrically to you.&#x0a;&#x0a;Melee Hits:&#x0a;Each hit rotates the target 90° to the right. Adjust only the number of hits (+/-) in the menu to anticipate the result.</system:String>
    <system:String x:Key="TxtNotice3BossCardTitle">Gusset Effect (Boss)</system:String>
    <system:String x:Key="TxtNotice3OddTurn">Odd Turn: YOU are teleported symmetrically to the Count.</system:String>
    <system:String x:Key="TxtNotice3EvenTurn">Even Turn: THE COUNT is teleported symmetrically to you.</system:String>
    <system:String x:Key="TxtNotice3MeleeCardTitle">Melee Hits</system:String>
    <system:String x:Key="TxtNotice3MeleeDesc">Each hit rotates the target 90° to the right. Adjust only the number of hits (+/-) in the menu to anticipate the result.</system:String>
    <system:String x:Key="TxtNotice4Title">4. SHORTCUTS &amp; TIPS</system:String>
    <system:String x:Key="TxtNotice4Desc">• F2: Start / Restart targeting.&#x0a;• F3: Show / Hide overlay.&#x0a;• F4: Clear tiles (resets melee hits to 0).&#x0a;&#x0a;• Interface: Double-click the top of the menu to minimize it.</system:String>
    <system:String x:Key="TxtNotice4ShortcutsCardTitle">Shortcuts</system:String>
    <system:String x:Key="TxtNotice4ShortcutF2">Start / restart targeting.</system:String>
    <system:String x:Key="TxtNotice4ShortcutF3">Show / hide the overlay.</system:String>
    <system:String x:Key="TxtNotice4ShortcutF4">Clear the tiles (resets melee hits to 0).</system:String>
    <system:String x:Key="TxtNotice4InterfaceCardTitle">Interface</system:String>
    <system:String x:Key="TxtNotice4InterfaceDesc">Double-click the top of the menu to minimize it.</system:String>
    <system:String x:Key="TxtNotice4Tip">💡 Tip: FROST tiles are 100% click-through. You can target or move in-game by clicking directly through them!</system:String>
    <system:String x:Key="TxtNotice5Title">5. LEGEND &amp; COLORBLINDNESS</system:String>
    <system:String x:Key="TxtNotice5Desc">FROST adapts to your vision! The legend colors below change automatically if you activate a Colorblind mode (Protanopia, Deuteranopia, Tritanopia) in the Settings.</system:String>
