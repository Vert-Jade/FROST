    <system:String x:Key="TxtNotice2Title">2. UŻYTKOWANIE</system:String>
    <system:String x:Key="TxtNotice2InputLine1">Wklej 82% lub prawidłową linię logu walki: FROST automatycznie ustawi próg i początkową orientację.</system:String>
