    <system:String x:Key="TxtNoticeHeader">BENUTZERHANDBUCH</system:String>
    <system:String x:Key="TxtNotice1Title">1. WIE ES FUNKTIONIERT</system:String>
    <system:String x:Key="TxtNotice1Desc">Diese Anwendung berechnet sofort und fehlerfrei die Verwirrungsmechanik von Graf Harebourg. Das Overlay legt sich sicher über Ihr Spiel (kein Screen-Reading).</system:String>
    <system:String x:Key="TxtNotice1IntroCardTitle">Überblick</system:String>
    <system:String x:Key="TxtNotice1SafetyCardTitle">Sicherheiten</system:String>
    <system:String x:Key="TxtNotice1SafetyLine1">100% visuelle und manuelle Berechnung der Mechanik des Grafen.</system:String>
    <system:String x:Key="TxtNotice1SafetyLine2">Kein Speicherlesen, kein Screen-Scanning, keine Automatisierung.</system:String>
    <system:String x:Key="TxtNotice1SafetyLine3">Das Overlay bleibt klick-durchlässig, damit Sie normal weiterspielen können.</system:String>
    <system:String x:Key="TxtNotice2Title">2. VERWENDUNG</system:String>
    <system:String x:Key="TxtNotice2InputLine1">Fügen Sie 82% oder eine gültige Kampflog-Zeile ein: FROST stellt Schwelle und Startausrichtung automatisch ein.</system:String>
    <system:String x:Key="TxtNotice2InputLine2">Der Zieltyp bleibt manuell: Sie müssen selbst Boss oder Monster wählen.</system:String>
    <system:String x:Key="TxtNotice2InputLine3">Die Anzahl der Nahkampftreffer bleibt manuell über die Tasten + / -.</system:String>
    <system:String x:Key="TxtNotice3Title">3. ERWEITERTE MECHANIKEN</system:String>
    <system:String x:Key="TxtNotice3Desc">Gusset-Effekt (Boss):&#x0a;Ungerader Zug: SIE werden symmetrisch zum Grafen teleportiert.&#x0a;Gerader Zug: DER GRAF wird symmetrisch zu Ihnen teleportiert.&#x0a;&#x0a;Nahkampfangriffe:&#x0a;Jeder Treffer dreht das Ziel um 90° nach rechts. Passen Sie nur die Anzahl der Schläge (+/-) im Menü an, um das Ergebnis vorwegzunehmen.</system:String>
    <system:String x:Key="TxtNotice3BossCardTitle">Gusset-Effekt (Boss)</system:String>
    <system:String x:Key="TxtNotice3OddTurn">Ungerader Zug: SIE werden symmetrisch zum Grafen teleportiert.</system:String>
    <system:String x:Key="TxtNotice3EvenTurn">Gerader Zug: DER GRAF wird symmetrisch zu Ihnen teleportiert.</system:String>
    <system:String x:Key="TxtNotice3MeleeCardTitle">Nahkampfangriffe</system:String>
    <system:String x:Key="TxtNotice3MeleeDesc">Jeder Treffer dreht das Ziel um 90° nach rechts. Passen Sie nur die Anzahl der Schläge (+/-) im Menü an, um das Ergebnis vorwegzunehmen.</system:String>
    <system:String x:Key="TxtNotice4Title">4. TASTENKÜRZEL &amp; TIPPS</system:String>
    <system:String x:Key="TxtNotice4Desc">• F2: Zielen starten / neu starten.&#x0a;• F3: Overlay anzeigen / ausblenden.&#x0a;• F4: Kacheln löschen (setzt die Nahkampftreffer auf 0 zurück).&#x0a;&#x0a;• Interface: Doppelklicken Sie oben auf das Menü, um es zu minimieren.</system:String>
    <system:String x:Key="TxtNotice4ShortcutsCardTitle">Tastenkürzel</system:String>
    <system:String x:Key="TxtNotice4ShortcutF2">Zielen starten / neu starten.</system:String>
    <system:String x:Key="TxtNotice4ShortcutF3">Overlay anzeigen / ausblenden.</system:String>
    <system:String x:Key="TxtNotice4ShortcutF4">Kacheln löschen (setzt die Nahkampftreffer auf 0 zurück).</system:String>
    <system:String x:Key="TxtNotice4InterfaceCardTitle">Oberfläche</system:String>
    <system:String x:Key="TxtNotice4InterfaceDesc">Doppelklicken Sie oben auf das Menü, um es zu minimieren.</system:String>
    <system:String x:Key="TxtNotice4Tip">💡 Tipp: Die FROST-Kacheln sind zu 100% klick-transparent. Sie können zielen oder sich im Spiel bewegen, indem Sie direkt durch sie hindurchklicken!</system:String>
    <system:String x:Key="TxtNotice5Title">5. LEGENDE &amp; FARBBLINDHEIT</system:String>
    <system:String x:Key="TxtNotice5Desc">FROST passt sich Ihrer Sicht an! Die Farben der Legende unten ändern sich automatisch, wenn Sie in den Einstellungen einen Farbenblind-Modus (Protanopie, Deuteranopie, Tritanopie) aktivieren.</system:String>
