    <system:String x:Key="TxtNotice1Title">1. HOE HET WERKT</system:String>
    <system:String x:Key="TxtNotice1Desc">Deze applicatie berekent onmiddellijk en foutloos de verwarringsmechanica van Graaf Harebourg. De overlay is veilig.</system:String>
    <system:String x:Key="TxtNotice1IntroCardTitle">Overzicht</system:String>
    <system:String x:Key="TxtNotice1SafetyCardTitle">Zekerheden</system:String>
