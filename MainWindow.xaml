<Window x:Class="FROST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST" WindowState="Normal" Width="1534.4" Height="814.4" MinWidth="80" MinHeight="60"
        Icon="pack://application:,,,/Ressources/Icones/frost.ico"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize">

    <Window.Resources>
        <!-- Pinceau dynamique pour lier toutes les surbrillances au thème choisi -->
        <SolidColorBrush x:Key="ThemeColorBrush" Color="#D4AF37"/>

        <!-- Modern Dofus 3.0 Button Style -->
        <Style x:Key="DofusButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#23252E"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#323540"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D303B"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeColorBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A1C23"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScreenSelectionButtonStyle" TargetType="Button" BasedOn="{StaticResource DofusButtonStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoticeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#171A22"/>
            <Setter Property="BorderBrush" Value="#2E3442"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="NoticeSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeColorBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="NoticeBodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="NoticeBulletGlyphStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="•"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,1,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="NoticeBulletTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4DAE5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SettingsSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8090"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="OnboardingSelectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#171A22"/>
            <Setter Property="BorderBrush" Value="#30384A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="OnboardingSectionCardStyle" TargetType="Border" BasedOn="{StaticResource OnboardingSelectionCardStyle}">
            <Setter Property="Background" Value="#1B202A"/>
            <Setter Property="BorderBrush" Value="#333B4F"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="OnboardingSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsSectionLabelStyle}">
            <Setter Property="Foreground" Value="#98A1B4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="MinHeight" Value="18"/>
        </Style>

        <Style x:Key="NoticeShortcutBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#10131A"/>
            <Setter Property="BorderBrush" Value="#283243"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="NoticeShortcutBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern Expander (Accordéon) -->
        <Style x:Key="ModernExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#323540"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              DockPanel.Dock="Top" Background="Transparent" Foreground="{TemplateBinding Foreground}" Cursor="Hand" Padding="5,10">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}">
                                                <Grid>
                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="20,0">
                                                        <ContentPresenter Content="{TemplateBinding Content}" TextBlock.FontWeight="Bold" TextBlock.FontSize="12" VerticalAlignment="Center"/>
                                                    </Viewbox>
                                                    <TextBlock x:Name="Arrow" Text="▼" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="▲"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeColorBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ToggleButton.Content>
                                        <ContentPresenter Content="{TemplateBinding Header}" />
                                    </ToggleButton.Content>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Focusable="false" DockPanel.Dock="Bottom" Margin="5,5,5,10"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les options de confusion -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#23252E"/>
            <Setter Property="BorderBrush" Value="#323540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D303B"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les petits boutons de sélection (Nombre de coups CàC) -->
        <Style x:Key="SmallToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#7A8090"/>
            <Setter Property="BorderBrush" Value="#323540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D303B"/>
                    <Setter Property="Foreground" Value="#E5E7EB"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedSmallToggleBtn" TargetType="Button" BasedOn="{StaticResource SmallToggleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="Transparent" Width="6" HorizontalAlignment="Right">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ThemeColorBrush}" CornerRadius="2" Opacity="0.8" Width="4" HorizontalAlignment="Center" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#323540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les boutons de Seuil -->
        <Style x:Key="ThresholdBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#23252E"/>
            <Setter Property="BorderBrush" Value="#323540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D303B"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8E9C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stretch="Uniform" Width="8" Height="8"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Minimize Button Style -->
        <Style x:Key="MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8E9C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Rectangle Width="8" Height="2" Fill="{TemplateBinding Foreground}" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeColorBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Info Button Style -->
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00A36C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                  Stretch="Uniform" Width="14" Height="14" Fill="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D303B"/>
                    <Setter Property="Foreground" Value="#00D08A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Back Button Style -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8E9C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                                  Stretch="Uniform" Width="14" Height="14" Fill="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D303B"/>
                    <Setter Property="Foreground" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Settings Button Style -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8E9C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z"
                                  Stretch="Uniform" Width="14" Height="14" Fill="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D303B"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les carrés de couleur -->
        <Style x:Key="ColorBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#323540" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Zone où l'on va dessiner les indicateurs (ciblage) -->
        <Canvas x:Name="OverlayCanvas" Background="{x:Null}" IsHitTestVisible="False" Margin="0"
                MouseDown="OverlayCanvas_MouseDown" MouseMove="OverlayCanvas_MouseMove" MouseUp="OverlayCanvas_MouseUp">
            <!-- Les icônes de la case à jouer apparaîtront ici -->
        </Canvas>

        <!-- Panneau de contrôle discret (Style Dofus 3.0 / Unity) -->
        <Border x:Name="ControlPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0"
                Background="#FF14161A" CornerRadius="8" Width="216" MinWidth="180" MinHeight="44"
                BorderBrush="#33404040" BorderThickness="1" ClipToBounds="True" SnapsToDevicePixels="True" SizeChanged="ControlPanel_SizeChanged">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.6" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Zone de déplacement (Header dédié) -->
                <Border Grid.Row="0" Background="#1E2028" CornerRadius="8,8,0,0" Padding="12,3"
                        MouseLeftButtonDown="ControlPanel_MouseLeftButtonDown"
                        MouseMove="ControlPanel_MouseMove"
                        MouseLeftButtonUp="ControlPanel_MouseLeftButtonUp"
                        Cursor="SizeAll"
                        BorderBrush="#33404040" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="BtnInfo" Style="{StaticResource InfoButtonStyle}" Cursor="Hand" Click="BtnInfo_Click" ToolTip="{DynamicResource TxtTooltipNotice}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnSettings" Style="{StaticResource SettingsButtonStyle}" Cursor="Hand" Click="BtnSettings_Click" ToolTip="{DynamicResource TxtTooltipSettings}"/>
                        </StackPanel>

                        <!-- Titre centré avec effet moderne -->
                        <TextBlock Foreground="#F3F4F6" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="FROST"/>
                            <Run Text=" v1.0.2" FontSize="9" FontWeight="Normal" Foreground="#7A8090"/>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#4DA8DA" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Boutons de contrôle à droite -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource MinimizeButtonStyle}" Cursor="Hand" Click="BtnCollapse_Click" Margin="0,0,4,0" ToolTip="{DynamicResource TxtTooltipMinimize}"/>
                            <Button Style="{StaticResource CloseButtonStyle}" Cursor="Hand" Click="BtnClose_Click" ToolTip="{DynamicResource TxtTooltipClose}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Conteneur principal (Menu vs Notice) -->
                <Grid Grid.Row="1" ClipToBounds="True">
                    <StackPanel x:Name="PanelContent" Margin="12">

                <!-- Combat Log -->
                <StackPanel x:Name="PanelCombatLog">
                    <TextBlock Text="{DynamicResource TxtOrientation}" Foreground="#7A8090" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,15">
                        <TextBox x:Name="TxtCombatLog" Background="#1A1C23" Foreground="#A0A5B5" BorderBrush="#323540" BorderThickness="1" Padding="6" TextChanged="TxtCombatLog_TextChanged" ToolTip="{DynamicResource TxtTooltipLog}"/>
                        <TextBlock x:Name="TxtCombatLogPlaceholder" Text="{DynamicResource TxtLogPlaceholder}" Foreground="#505364" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>

                <!-- Seuils de Vie -->
                <Expander x:Name="ExpThreshold" Header="{DynamicResource TxtThreshold}" Style="{StaticResource ModernExpander}" IsExpanded="True" Expanded="MainPanelSection_Changed" Collapsed="MainPanelSection_Changed">
                    <StackPanel Margin="0,5,0,0">
                        <Grid x:Name="ThresholdGrid" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnSeuil1" Grid.Column="0" Grid.Row="0" Click="BtnThreshold_Click" Style="{StaticResource ThresholdBtnStyle}" Tag="1_90" ToolTip="100% - 90%">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="100%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <Grid Height="48" Width="48" Margin="0,2">
                                <Image x:Name="ImgSeuil1" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_1.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="90%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSeuil2" Grid.Column="1" Grid.Row="0" Click="BtnThreshold_Click" Style="{StaticResource ThresholdBtnStyle}" Tag="2_270" Opacity="0.4" ToolTip="89% - 75%">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="89%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <Grid Height="48" Width="48" Margin="0,2">
                                <Image x:Name="ImgSeuil2" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_2.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="75%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSeuil3" Grid.Column="2" Grid.Row="0" Click="BtnThreshold_Click" Style="{StaticResource ThresholdBtnStyle}" Tag="3_180" Opacity="0.4" ToolTip="74% - 45%">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="74%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <Grid Height="48" Width="48" Margin="0,2">
                                <Image x:Name="ImgSeuil3" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_3.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="45%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSeuil4" Grid.Column="3" Grid.Row="0" Click="BtnThreshold_Click" Style="{StaticResource ThresholdBtnStyle}" Tag="4_270" Opacity="0.4" ToolTip="44% - 30%">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="44%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <Grid Height="48" Width="48" Margin="0,2">
                                <Image x:Name="ImgSeuil4" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_4.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="30%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSeuil5" Grid.Column="4" Grid.Row="0" Click="BtnThreshold_Click" Style="{StaticResource ThresholdBtnStyle}" Tag="5_90" Opacity="0.4" ToolTip="29% - 0%">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="29%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <Grid Height="48" Width="48" Margin="0,2">
                                <Image x:Name="ImgSeuil5" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_5.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="0%" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Seuils de Vie compacts : disposition stable, sans compression des icônes -->
                <Grid x:Name="ThresholdGridCompact" Margin="0,0,0,8" Visibility="Collapsed" UseLayoutRounding="True">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="BtnSeuil1Compact" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Click="BtnThreshold_Click" Tag="1_90" ToolTip="100% - 90%" Style="{StaticResource ThresholdBtnStyle}" Height="60" MinWidth="0" Padding="2" Margin="2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="100-90%" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="ImgSeuil1Compact" Grid.Row="1" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_1.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="BtnSeuil2Compact" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Click="BtnThreshold_Click" Tag="2_270" Opacity="0.4" ToolTip="89% - 75%" Style="{StaticResource ThresholdBtnStyle}" Height="60" MinWidth="0" Padding="2" Margin="2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="89-75%" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="ImgSeuil2Compact" Grid.Row="1" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_2.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="BtnSeuil3Compact" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Click="BtnThreshold_Click" Tag="3_180" Opacity="0.4" ToolTip="74% - 45%" Style="{StaticResource ThresholdBtnStyle}" Height="60" MinWidth="0" Padding="2" Margin="2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="74-45%" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="ImgSeuil3Compact" Grid.Row="1" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_3.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnSeuil4Compact" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Click="BtnThreshold_Click" Tag="4_270" Opacity="0.4" ToolTip="44% - 30%" Style="{StaticResource ThresholdBtnStyle}" Height="60" MinWidth="0" Padding="2" Margin="2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="44-30%" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="ImgSeuil4Compact" Grid.Row="1" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_4.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="BtnSeuil5Compact" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Click="BtnThreshold_Click" Tag="5_90" Opacity="0.4" ToolTip="29% - 0%" Style="{StaticResource ThresholdBtnStyle}" Height="60" MinWidth="0" Padding="2" Margin="2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="29-0%" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="ImgSeuil5Compact" Grid.Row="1" Source="pack://application:,,,/Ressources/Apparences/Coeur_1/Seuil_5.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
                    </StackPanel>
                </Expander>

                <!-- Mécaniques Avancées (Gousset) -->
                <Expander x:Name="ExpAdvanced" Header="{DynamicResource TxtAdvanced}" Style="{StaticResource ModernExpander}" IsExpanded="True" Expanded="MainPanelSection_Changed" Collapsed="MainPanelSection_Changed">
                    <StackPanel Margin="0,5,0,0">
                        <StackPanel x:Name="PanelTargetType" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                    <TextBlock Text="{DynamicResource TxtTarget}" Foreground="#A0A5B5" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Grid MaxWidth="140" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnTargetMob" Grid.Column="0" Tag="Mob" Style="{StaticResource SmallToggleBtn}" Height="46" Click="BtnTargetType_Click" Background="#2D303B" BorderBrush="{DynamicResource ThemeColorBrush}" ToolTip="{DynamicResource TooltipMob}" Margin="0,0,5,0">
                            <Image x:Name="ImgTargetMob" Source="pack://application:,,,/Ressources/Icones/mob.png" MaxWidth="36" MaxHeight="36" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnTargetBoss" Grid.Column="1" Tag="Boss" Style="{StaticResource SmallToggleBtn}" Height="46" Click="BtnTargetType_Click" ToolTip="{DynamicResource TooltipBoss}" Margin="5,0,0,0">
                            <Image x:Name="ImgTargetBoss" Source="pack://application:,,,/Ressources/Icones/harebourg.png" MaxWidth="36" MaxHeight="36" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="GridTurnType" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Stretch">
                    <TextBlock Text="{DynamicResource TxtCurrentTurn}" Foreground="#A0A5B5" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Grid MaxWidth="180" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnTurnOdd" Grid.Column="0" Content="{DynamicResource TxtOdd}" Tag="Odd" Style="{StaticResource RoundedSmallToggleBtn}" Height="28" Click="BtnTurn_Click" Background="#2D303B" Foreground="{DynamicResource ThemeColorBrush}" BorderBrush="{DynamicResource ThemeColorBrush}" Margin="0,0,5,0"/>
                        <Button x:Name="BtnTurnEven" Grid.Column="1" Content="{DynamicResource TxtEven}" Tag="Even" Style="{StaticResource RoundedSmallToggleBtn}" Height="28" Click="BtnTurn_Click" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Paramètres d'attaque (CàC) -->
                <Expander x:Name="ExpMelee" Header="{DynamicResource TxtMelee}" Style="{StaticResource ModernExpander}" IsExpanded="True" Expanded="MainPanelSection_Changed" Collapsed="MainPanelSection_Changed">
                    <StackPanel Margin="0,5,0,0">
                        <StackPanel x:Name="PanelHitCount" Margin="0" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource TxtHitCount}" Foreground="#A0A5B5" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnHitMinus" Content="−" Style="{StaticResource RoundedSmallToggleBtn}" Width="28" Height="28" Click="BtnHitMinus_Click"/>
                                <Border Background="#1A1C23" BorderBrush="#323540" BorderThickness="1" CornerRadius="4" Width="40" Margin="8,0">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                        <TextBlock x:Name="TxtHitCount" Text="0" Foreground="{DynamicResource ThemeColorBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Viewbox>
                                </Border>
                                <Button x:Name="BtnHitPlus" Content="+" Style="{StaticResource RoundedSmallToggleBtn}" Width="28" Height="28" Click="BtnHitPlus_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                    </StackPanel>

                    <!-- VUE NOTICE D'UTILISATION -->
                    <Grid x:Name="NoticeContent" Visibility="Collapsed" Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- En-tête Notice (Flèche de retour) -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnNoticeBackToApp" Style="{StaticResource BackButtonStyle}" Click="BtnBack_Click" ToolTip="{DynamicResource TxtTooltipBack}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtNoticeHeader}" Foreground="#F3F4F6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-24,0,0,0"/>
                        </Grid>

                        <!-- Corps de la Notice (Pagination) -->
                        <Grid Grid.Row="1">

                            <!-- SOMMAIRE -->
                            <StackPanel x:Name="NoticeSummary" Visibility="Visible">
                                <TextBlock Text="{DynamicResource TxtNoticeSummaryTitle}" Foreground="#7A8090" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Button Content="{DynamicResource TxtNotice1Title}" Tag="1" Style="{StaticResource DofusButtonStyle}" HorizontalContentAlignment="Left" Click="BtnNoticePage_Click" Padding="12,8"/>
                                <Button Content="{DynamicResource TxtNotice2Title}" Tag="2" Style="{StaticResource DofusButtonStyle}" HorizontalContentAlignment="Left" Click="BtnNoticePage_Click" Padding="12,8"/>
                                <Button Content="{DynamicResource TxtNotice3Title}" Tag="3" Style="{StaticResource DofusButtonStyle}" HorizontalContentAlignment="Left" Click="BtnNoticePage_Click" Padding="12,8"/>
                                <Button Content="{DynamicResource TxtNotice4Title}" Tag="4" Style="{StaticResource DofusButtonStyle}" HorizontalContentAlignment="Left" Click="BtnNoticePage_Click" Padding="12,8"/>
                                <Button Content="{DynamicResource TxtNotice5Title}" Tag="5" Style="{StaticResource DofusButtonStyle}" HorizontalContentAlignment="Left" Click="BtnNoticePage_Click" Padding="12,8"/>
                            </StackPanel>

                            <!-- CONTENU DES PAGES -->
                            <Grid x:Name="NoticePageContainer" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Bouton retour sommaire -->
                                <Button x:Name="BtnNoticeSummaryBack" Grid.Row="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#A0A5B5" Cursor="Hand" Click="BtnNoticeSummary_Click" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◀" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource TxtNoticeBack}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                                    <Grid Margin="0,0,0,4" MinWidth="0" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <!-- PAGE 1 -->
                                        <StackPanel x:Name="Page1" Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource TxtNotice1Title}" Foreground="#E5E7EB" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <Border Style="{StaticResource NoticeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice1IntroCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>
                                                    <TextBlock Text="{DynamicResource TxtNotice1Desc}" Style="{StaticResource NoticeBodyTextStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource NoticeCardStyle}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice1SafetyCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice1SafetyLine1}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice1SafetyLine2}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice1SafetyLine3}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- PAGE 2 -->
                                        <StackPanel x:Name="Page2" Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource TxtNotice2Title}" Foreground="#E5E7EB" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <Border Style="{StaticResource NoticeCardStyle}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtCatUsage}" Style="{StaticResource NoticeSectionTitleStyle}"/>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice2InputLine1}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                    <TextBlock Text="{DynamicResource TxtLogPlaceholder}" Foreground="#8E97A8" FontSize="11.5" Margin="21,0,0,8" TextWrapping="Wrap"/>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice2InputLine2}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice2InputLine3}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <Grid Grid.Column="1" MinWidth="0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource NoticeShortcutBadgeStyle}">
                                                                <TextBlock Text="F2" Style="{StaticResource NoticeShortcutBadgeTextStyle}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtShortcutStart}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                        </Grid>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource StatusStep1}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource StatusStep2}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                    <Border Background="#1C2A20" BorderBrush="#2C5C38" BorderThickness="1" CornerRadius="6" Padding="10">
                                                        <TextBlock Text="{DynamicResource TxtNotice4Tip}" Foreground="#4CAF50" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- PAGE 3 -->
                                        <StackPanel x:Name="Page3" Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource TxtNotice3Title}" Foreground="#E5E7EB" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <Border Style="{StaticResource NoticeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice3BossCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice3OddTurn}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice3EvenTurn}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource NoticeCardStyle}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice3MeleeCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice3MeleeDesc}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- PAGE 4 -->
                                        <StackPanel x:Name="Page4" Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource TxtNotice4Title}" Foreground="#E5E7EB" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <Border Style="{StaticResource NoticeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice4ShortcutsCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <Grid Grid.Column="1" MinWidth="0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource NoticeShortcutBadgeStyle}">
                                                                <TextBlock Text="F2" Style="{StaticResource NoticeShortcutBadgeTextStyle}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice4ShortcutF2}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                        </Grid>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <Grid Grid.Column="1" MinWidth="0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource NoticeShortcutBadgeStyle}">
                                                                <TextBlock Text="F3" Style="{StaticResource NoticeShortcutBadgeTextStyle}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice4ShortcutF3}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                        </Grid>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <Grid Grid.Column="1" MinWidth="0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource NoticeShortcutBadgeStyle}">
                                                                <TextBlock Text="F4" Style="{StaticResource NoticeShortcutBadgeTextStyle}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice4ShortcutF4}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource NoticeCardStyle}" Margin="0,0,0,15">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice4InterfaceCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource NoticeBulletGlyphStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtNotice4InterfaceDesc}" Style="{StaticResource NoticeBulletTextStyle}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#1C2A20" BorderBrush="#2C5C38" BorderThickness="1" CornerRadius="6" Padding="12">
                                                <TextBlock Text="{DynamicResource TxtNotice4Tip}" Foreground="#4CAF50" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- PAGE 5 -->
                                        <StackPanel x:Name="Page5" Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource TxtNotice5Title}" Foreground="#E5E7EB" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <Border Style="{StaticResource NoticeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice5VisualCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>
                                                    <TextBlock Text="{DynamicResource TxtNotice5Desc}" Style="{StaticResource NoticeBodyTextStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource NoticeCardStyle}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtNotice5LegendCardTitle}" Style="{StaticResource NoticeSectionTitleStyle}"/>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border x:Name="NoticeLegendPlayer" Width="20" Height="20" CornerRadius="4" Background="#00BFFF" BorderBrush="#87CEEB" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendPlayer}" Foreground="#A0A5B5" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border x:Name="NoticeLegendBoss" Width="20" Height="20" CornerRadius="4" Background="#DC143C" BorderBrush="#FF4500" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendBoss}" Foreground="#A0A5B5" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border x:Name="NoticeLegendTarget" Width="20" Height="20" CornerRadius="4" Background="#6C0EBA" BorderBrush="#8C19E6" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendTarget}" Foreground="#F3F4F6" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border x:Name="NoticeLegendTP" Width="20" Height="20" CornerRadius="4" Background="#FF007F" BorderBrush="#FF66CC" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendTP}" Foreground="#A0A5B5" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <Border x:Name="NoticeWizardFooter" Grid.Row="2" Visibility="Collapsed" Background="#171A22" BorderBrush="#2E3442" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtNoticeWizardProgress" Foreground="#A0A5B5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="BtnNoticeWizardNext" Grid.Column="1" Style="{StaticResource DofusButtonStyle}" Click="BtnNoticeWizardNext_Click" Margin="12,0,0,0" MinWidth="118" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- VUE PARAMÈTRES -->
                    <Grid x:Name="SettingsContent" Visibility="Collapsed" Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource BackButtonStyle}" Click="BtnBackSettings_Click" ToolTip="{DynamicResource TxtTooltipBack}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtSettingsHeader}" Foreground="#F3F4F6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-24,0,0,0"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                            <StackPanel>
                                <!-- 0. AFFICHAGE -->
                                <Expander Header="{DynamicResource TxtCatDisplay}" Style="{StaticResource ModernExpander}" IsExpanded="True">
                                    <StackPanel Margin="0,5,0,5">
                                        <TextBlock Text="{DynamicResource TxtViewMode}" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,15">
                                            <Button x:Name="BtnViewFull" Content="{DynamicResource TxtViewFull}" Style="{StaticResource DofusButtonStyle}" Click="BtnViewMode_Click" Tag="Full" Margin="0,0,5,0" HorizontalContentAlignment="Center"/>
                                            <Button x:Name="BtnViewCompact" Content="{DynamicResource TxtViewCompact}" Style="{StaticResource DofusButtonStyle}" Click="BtnViewMode_Click" Tag="Compact" Margin="5,0,0,0" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>

                                        <TextBlock Text="{DynamicResource TxtScreenSelect}" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                        <StackPanel x:Name="ScreenListPanel" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Expander>

                                <!-- 1. APPARENCE -->
                                <Expander Header="{DynamicResource TxtCatAppearance}" Style="{StaticResource ModernExpander}" IsExpanded="True">
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="{DynamicResource TxtIconTheme}" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,15">
                                            <Button x:Name="BtnTheme0" Tag="0" Style="{StaticResource ThresholdBtnStyle}" Click="BtnIconTheme_Click" ToolTip="{DynamicResource TxtThemeDefault}" Padding="8">
                                                <Image x:Name="ImgTheme0" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                            </Button>
                                            <Button x:Name="BtnTheme1" Tag="1" Style="{StaticResource ThresholdBtnStyle}" Click="BtnIconTheme_Click" Opacity="0.4" ToolTip="Harebourg 1" Padding="8">
                                                <Image x:Name="ImgTheme1" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                            </Button>
                                            <Button x:Name="BtnTheme2" Tag="2" Style="{StaticResource ThresholdBtnStyle}" Click="BtnIconTheme_Click" Opacity="0.4" ToolTip="Harebourg 2" Padding="8">
                                                <Image x:Name="ImgTheme2" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                            </Button>
                                        </UniformGrid>

                                        <TextBlock Text="{DynamicResource TxtMainColor}" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,0,0,15">
                                            <UniformGrid x:Name="ThemeColorGrid" Columns="5">
                                                <Button Background="#D4AF37" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#4DA8DA" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#FF007F" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#6C0EBA" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#00A36C" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#E81123" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#FF8C00" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#FFD700" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#32CD32" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                                <Button Background="#00CED1" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                            </UniformGrid>
                                        </Viewbox>

                                        <TextBlock Text="{DynamicResource TxtLargeText}" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,0,0,5"/>
                                        <Button x:Name="BtnToggleLargeText" Content="{DynamicResource TxtLargeText}" Style="{StaticResource DofusButtonStyle}" Click="BtnToggleLargeText_Click" Margin="0,0,0,15" HorizontalContentAlignment="Center"/>

                                        <TextBlock Text="{DynamicResource TxtOpacity}" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,0,0,5"/>
                                        <Slider x:Name="SliderOpacity" Minimum="0.8" Maximum="1.0" Value="1.0" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" TickFrequency="0.05" LargeChange="0.05" SmallChange="0.05" ValueChanged="SliderOpacity_ValueChanged" Margin="0,0,0,5" ToolTip="{DynamicResource TxtTooltipOpacity}"/>
                                    </StackPanel>
                                </Expander>

                                <!-- 2. LANGUE -->
                                <Expander Header="{DynamicResource TxtCatLanguage}" Style="{StaticResource ModernExpander}" IsExpanded="True">
                                    <UniformGrid Columns="4" Margin="0,5,0,5">
                                        <Button x:Name="BtnLang0" Tag="0" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangFr}" Padding="8">
                                            <Image x:Name="ImgLang0" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang5" Tag="5" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangDe}" Padding="8">
                                            <Image x:Name="ImgLang5" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang1" Tag="1" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangEn}" Padding="8">
                                            <Image x:Name="ImgLang1" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang6" Tag="6" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangAr}" Padding="8">
                                            <Image x:Name="ImgLang6" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang3" Tag="3" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangEs}" Padding="8">
                                            <Image x:Name="ImgLang3" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang4" Tag="4" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangIt}" Padding="8">
                                            <Image x:Name="ImgLang4" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang7" Tag="7" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangNl}" Padding="8">
                                            <Image x:Name="ImgLang7" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang8" Tag="8" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangPl}" Padding="8">
                                            <Image x:Name="ImgLang8" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang2" Tag="2" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangPt}" Padding="8">
                                            <Image x:Name="ImgLang2" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang9" Tag="9" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangRu}" Padding="8">
                                            <Image x:Name="ImgLang9" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang10" Tag="10" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangSv}" Padding="8">
                                            <Image x:Name="ImgLang10" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="BtnLang11" Tag="11" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangTr}" Padding="8">
                                            <Image x:Name="ImgLang11" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                        </Button>
                                    </UniformGrid>
                                </Expander>

                                <!-- 3. ACCESSIBILITÉ -->
                                <Expander Header="{DynamicResource TxtCatAccessibility}" Style="{StaticResource ModernExpander}" IsExpanded="True">
                                    <UniformGrid Columns="2" Margin="0,5,0,5">
                                        <Button x:Name="BtnCb0" Tag="0" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbNormal}" Padding="10">
                                            <StackPanel>
                                                <Image x:Name="ImgCb0" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,8"/>
                                                <TextBlock Text="{DynamicResource TxtCbNormal}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnCb1" Tag="1" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbProtanopia}" Padding="10">
                                            <StackPanel>
                                                <Image x:Name="ImgCb1" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,8"/>
                                                <TextBlock Text="{DynamicResource TxtCbProtanopia}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnCb2" Tag="2" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbDeuteranopia}" Padding="10">
                                            <StackPanel>
                                                <Image x:Name="ImgCb2" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,8"/>
                                                <TextBlock Text="{DynamicResource TxtCbDeuteranopia}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnCb3" Tag="3" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbTritanopia}" Padding="10">
                                            <StackPanel>
                                                <Image x:Name="ImgCb3" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,8"/>
                                                <TextBlock Text="{DynamicResource TxtCbTritanopia}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </Expander>

                                <!-- 5. RACCOURCIS -->
                                <Expander Header="{DynamicResource TxtCatShortcuts}" Style="{StaticResource ModernExpander}" IsExpanded="True">
                                    <StackPanel Margin="0,5,0,5">
                                        <TextBlock Text="{DynamicResource TxtShortcutsDesc}" Foreground="#A0A5B5" FontSize="11" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,10,0">
                                                <TextBlock Text="{DynamicResource TxtShortcutStart}" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                                            </Viewbox>
                                            <TextBox x:Name="TxtKeyStart" Grid.Column="1" Width="80" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Start" Background="#1A1C23" Foreground="{DynamicResource ThemeColorBrush}" BorderBrush="#323540" TextAlignment="Center" FontWeight="Bold" Cursor="Hand"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,10,0">
                                                <TextBlock Text="{DynamicResource TxtShortcutHide}" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                                            </Viewbox>
                                            <TextBox x:Name="TxtKeyToggle" Grid.Column="1" Width="80" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Toggle" Background="#1A1C23" Foreground="{DynamicResource ThemeColorBrush}" BorderBrush="#323540" TextAlignment="Center" FontWeight="Bold" Cursor="Hand"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,10,0">
                                                <TextBlock Text="{DynamicResource TxtShortcutClear}" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                                            </Viewbox>
                                            <TextBox x:Name="TxtKeyClear" Grid.Column="1" Width="80" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Clear" Background="#1A1C23" Foreground="{DynamicResource ThemeColorBrush}" BorderBrush="#323540" TextAlignment="Center" FontWeight="Bold" Cursor="Hand"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- 6. LÉGENDE -->
                                <Expander Header="{DynamicResource TxtCatLegend}" Style="{StaticResource ModernExpander}" IsExpanded="True">
                                    <StackPanel Margin="0,5,0,5">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="LegendPlayer" Width="18" Height="18" CornerRadius="4" BorderThickness="1" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendPlayer}" Foreground="#A0A5B5" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="LegendBoss" Width="18" Height="18" CornerRadius="4" BorderThickness="1" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendBoss}" Foreground="#A0A5B5" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="LegendTarget" Width="18" Height="18" CornerRadius="4" BorderThickness="1" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendTarget}" Foreground="#F3F4F6" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="LegendTP" Width="18" Height="18" CornerRadius="4" BorderThickness="1" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource TxtLegendTP}" Foreground="#A0A5B5" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Poignées pour redimensionner LE MENU -->
                    <Thumb HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" Cursor="SizeWE" DragDelta="MenuResizeRightGrip_DragDelta" DragCompleted="MenuResizeGrip_DragCompleted" ToolTip="{DynamicResource TxtTooltipResize}">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <Thumb Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Cursor="SizeNWSE" DragDelta="MenuResizeGrip_DragDelta" DragCompleted="MenuResizeGrip_DragCompleted" ToolTip="{DynamicResource TxtTooltipResize}">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M10,0 L10,10 L0,10 Z" Fill="{DynamicResource ThemeColorBrush}" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>

        <!-- ASSISTANT PREMIER LANCEMENT (WIZARD MINIMALISTE) -->
        <Border x:Name="OnboardingOverlay" Visibility="Collapsed" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="Onboarding_MouseLeftButtonDown" MouseMove="Onboarding_MouseMove" MouseLeftButtonUp="Onboarding_MouseLeftButtonUp" Background="{x:Null}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="OnboardingTranslate" X="0" Y="0"/>
            </Border.RenderTransform>
            <Border Background="#1A1C23" BorderBrush="#323540" BorderThickness="1" CornerRadius="8" Width="440" Height="440">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.8" Color="Black"/></Border.Effect>
                <Grid>
                    <!-- Croix de fermeture en haut à droite -->
                    <Button Style="{StaticResource CloseButtonStyle}" Cursor="Hand" Click="BtnCloseOnboarding_Click" ToolTip="{DynamicResource TxtTooltipClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Panel.ZIndex="10"/>

                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="OnbStepContent" Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock x:Name="OnbStepText" Text="{DynamicResource TxtOnbLang}" Foreground="#E5E7EB" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap" TextAlignment="Center"/>

                            <!-- STEP 1: LANGUE -->
                            <UniformGrid x:Name="GridOnbLang" Columns="4" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Button x:Name="BtnOnbLang0" Tag="0" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangFr}" Padding="8">
                                    <Image x:Name="ImgOnbLang0" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang5" Tag="5" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangDe}" Padding="8">
                                    <Image x:Name="ImgOnbLang5" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang1" Tag="1" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangEn}" Padding="8">
                                    <Image x:Name="ImgOnbLang1" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang6" Tag="6" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangAr}" Padding="8">
                                    <Image x:Name="ImgOnbLang6" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang3" Tag="3" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangEs}" Padding="8">
                                    <Image x:Name="ImgOnbLang3" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang4" Tag="4" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangIt}" Padding="8">
                                    <Image x:Name="ImgOnbLang4" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang7" Tag="7" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangNl}" Padding="8">
                                    <Image x:Name="ImgOnbLang7" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang8" Tag="8" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangPl}" Padding="8">
                                    <Image x:Name="ImgOnbLang8" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang2" Tag="2" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangPt}" Padding="8">
                                    <Image x:Name="ImgOnbLang2" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang9" Tag="9" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangRu}" Padding="8">
                                    <Image x:Name="ImgOnbLang9" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang10" Tag="10" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangSv}" Padding="8">
                                    <Image x:Name="ImgOnbLang10" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnOnbLang11" Tag="11" Style="{StaticResource ThresholdBtnStyle}" Click="BtnLanguage_Click" ToolTip="{DynamicResource TxtLangTr}" Padding="8">
                                    <Image x:Name="ImgOnbLang11" MaxWidth="56" MaxHeight="56" Stretch="Uniform"/>
                                </Button>
                            </UniformGrid>

                            <!-- STEP 2: BIENVENUE -->
                            <StackPanel x:Name="GridOnbWelcome" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Ressources/Icones/Bienvenue.png" MaxHeight="160" Stretch="Uniform" Margin="0,0,0,15"/>
                                <TextBlock Text="{DynamicResource TxtWelcome}" Foreground="{DynamicResource ThemeColorBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <TextBlock Text="{DynamicResource TxtOnbWelcomeDesc}" Foreground="#A0A5B5" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="20,0"/>
                            </StackPanel>

                            <!-- STEP 3: ECRAN -->
                            <StackPanel x:Name="GridOnbScreen" Visibility="Collapsed" HorizontalAlignment="Center" Width="388">
                                <Border Style="{StaticResource OnboardingSelectionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TxtOnbScreenSection}" Style="{StaticResource OnboardingSectionTitleStyle}" Margin="0,0,0,12"/>
                                        <WrapPanel x:Name="OnbScreenListPanel" HorizontalAlignment="Stretch" ItemHeight="42" Margin="0,0,0,2"/>

                                        <Border Height="1" Background="#262C38" Margin="0,16,0,14"/>

                                        <Grid>
                                            <Border Style="{StaticResource OnboardingSectionCardStyle}" MinHeight="102">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TxtOnbViewModeSection}" Style="{StaticResource OnboardingSectionTitleStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnOnbViewFull" Grid.Column="0" Content="{DynamicResource TxtViewFull}" Style="{StaticResource ScreenSelectionButtonStyle}" Click="BtnViewMode_Click" Tag="Full" Height="32" HorizontalContentAlignment="Center" Margin="0"/>
                                                        <Button x:Name="BtnOnbViewCompact" Grid.Column="2" Content="{DynamicResource TxtViewCompact}" Style="{StaticResource ScreenSelectionButtonStyle}" Click="BtnViewMode_Click" Tag="Compact" Height="32" HorizontalContentAlignment="Center" Margin="0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- STEP 3: DALTONISME -->
                            <UniformGrid x:Name="GridOnbCb" Columns="2" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Button x:Name="BtnOnbCb0" Tag="0" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbNormal}" Padding="15">
                                    <StackPanel><Image x:Name="ImgOnbCb0" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,12"/><TextBlock Text="{DynamicResource TxtCbNormal}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnOnbCb1" Tag="1" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbProtanopia}" Padding="15">
                                    <StackPanel><Image x:Name="ImgOnbCb1" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,12"/><TextBlock Text="{DynamicResource TxtCbProtanopia}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnOnbCb2" Tag="2" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbDeuteranopia}" Padding="15">
                                    <StackPanel><Image x:Name="ImgOnbCb2" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,12"/><TextBlock Text="{DynamicResource TxtCbDeuteranopia}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnOnbCb3" Tag="3" Style="{StaticResource ThresholdBtnStyle}" Click="BtnColorblind_Click" ToolTip="{DynamicResource TxtCbTritanopia}" Padding="15">
                                    <StackPanel><Image x:Name="ImgOnbCb3" MaxWidth="60" MaxHeight="60" Stretch="Uniform" Margin="0,0,0,12"/><TextBlock Text="{DynamicResource TxtCbTritanopia}" MaxWidth="110" Foreground="#E5E7EB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                            </UniformGrid>

                            <!-- STEP 4: COULEUR DU THÈME -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                <UniformGrid x:Name="GridOnbColor" Columns="5" Visibility="Collapsed">
                                    <Button Background="#D4AF37" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#4DA8DA" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#FF007F" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#6C0EBA" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#00A36C" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#E81123" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#FF8C00" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#FFD700" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#32CD32" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                    <Button Background="#00CED1" Style="{StaticResource ColorBtnStyle}" Click="BtnThemeColor_Click"/>
                                </UniformGrid>
                            </Viewbox>

                            <!-- STEP 5: STYLE D'ICÔNES -->
                            <UniformGrid x:Name="GridOnbTheme" Columns="3" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Button x:Name="BtnOnbTheme0" Tag="0" Style="{StaticResource ThresholdBtnStyle}" Click="BtnIconTheme_Click" ToolTip="{DynamicResource TxtThemeDefault}" Padding="12"><Image x:Name="ImgOnbTheme0" MaxWidth="64" MaxHeight="64" Stretch="Uniform"/></Button>
                                <Button x:Name="BtnOnbTheme1" Tag="1" Style="{StaticResource ThresholdBtnStyle}" Click="BtnIconTheme_Click" Opacity="0.4" ToolTip="Harebourg 1" Padding="12"><Image x:Name="ImgOnbTheme1" MaxWidth="64" MaxHeight="64" Stretch="Uniform"/></Button>
                                <Button x:Name="BtnOnbTheme2" Tag="2" Style="{StaticResource ThresholdBtnStyle}" Click="BtnIconTheme_Click" Opacity="0.4" ToolTip="Harebourg 2" Padding="12"><Image x:Name="ImgOnbTheme2" MaxWidth="64" MaxHeight="64" Stretch="Uniform"/></Button>
                            </UniformGrid>

                            <!-- STEP 6: CRÉDITS -->
                            <StackPanel x:Name="GridOnbCredits" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="ImgCreator" Source="pack://application:,,,/Ressources/Icones/Credits.png" MaxHeight="200" Stretch="Uniform" Margin="0,0,0,20">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CreatorScale" ScaleX="1.1518441101562502" ScaleY="1.1518441101562502"/>
                                            <TranslateTransform x:Name="CreatorTranslate" X="22.666666666666742" Y="-2.000000000000057"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                    <Image.Effect><DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.4"/></Image.Effect>
                                </Image>
                                <TextBlock Text="FROST" Foreground="{DynamicResource ThemeColorBrush}" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/></TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource TxtOnbSlogan}" Foreground="#E5E7EB" FontSize="15" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="© Luframe" Foreground="{DynamicResource ThemeColorBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="&amp;" Foreground="#A0A5B5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="© Vert-Jade" Foreground="{DynamicResource ThemeColorBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="DotStep1" Width="8" Height="8" Fill="{DynamicResource ThemeColorBrush}" Margin="2"/>
                                <Ellipse x:Name="DotStep2" Width="8" Height="8" Fill="#323540" Margin="2"/>
                                <Ellipse x:Name="DotStep3" Width="8" Height="8" Fill="#323540" Margin="2"/>
                                <Ellipse x:Name="DotStep4" Width="8" Height="8" Fill="#323540" Margin="2"/>
                                <Ellipse x:Name="DotStep5" Width="8" Height="8" Fill="#323540" Margin="2"/>
                                <Ellipse x:Name="DotStep6" Width="8" Height="8" Fill="#323540" Margin="2"/>
                                <Ellipse x:Name="DotStep7" Width="8" Height="8" Fill="#323540" Margin="2"/>
                            </StackPanel>
                            <Button x:Name="BtnOnbNext" Content="{DynamicResource TxtNext}" Style="{StaticResource DofusButtonStyle}" HorizontalAlignment="Right" Padding="15,6" Click="BtnOnbNext_Click" Background="{DynamicResource ThemeColorBrush}" Foreground="#1A1C23" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- POPUP DE FIN DE CONFIGURATION (SUCCÈS) -->
        <Border x:Name="SuccessOverlay" Visibility="Collapsed" Panel.ZIndex="200" Background="#99000000">
            <Border Background="#1A1C23" BorderBrush="{DynamicResource ThemeColorBrush}" BorderThickness="2" CornerRadius="8" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SuccessTranslate" X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.8" Color="Black"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource TxtOnbFinishedTitle}" Foreground="{DynamicResource ThemeColorBrush}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="{DynamicResource TxtOnbFinishedMsg}" Foreground="#E5E7EB" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,25" LineHeight="22"/>
                    <Button Content="{DynamicResource TxtContinue}" Style="{StaticResource DofusButtonStyle}" Background="{DynamicResource ThemeColorBrush}" Foreground="#1A1C23" FontWeight="Bold" FontSize="14" Height="40" Click="BtnSuccessContinue_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
