<Window x:Class="FROST.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST Uninstall"
        Icon="pack://application:,,,/Ressources/Icones/frost.ico"
        Width="760" Height="460"
        MinWidth="760" MinHeight="460"
        MaxWidth="760" MaxHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="UninstallPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8FEFFF"/>
            <Setter Property="Foreground" Value="#0D0F14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B7FBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#54C8D8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1C3038"/>
                                <Setter Property="Foreground" Value="#5A8590"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UninstallSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="BorderBrush" Value="#2E3442"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#23252E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A5168"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UninstallCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A5168"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UninstallCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" Background="#2D303B" BorderBrush="#3A4055" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0">
                                <TextBlock x:Name="chk" Text="✓" FontSize="11" FontWeight="Bold" Foreground="#8FEFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#8FEFFF"/>
                                <Setter TargetName="box" Property="Background" Value="#0B2A32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UninstallProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#1E2230" CornerRadius="4" Height="8"/>
                            <Border x:Name="PART_Indicator" CornerRadius="4,0,0,4" Height="8" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8FEFFF" Offset="0"/>
                                        <GradientStop Color="#B7FBFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#8FEFFF" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#1B1F29" BorderBrush="#252A38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource TxtUninstallWindowTitle}" Foreground="#303848" FontSize="11" VerticalAlignment="Center" Margin="24,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource UninstallCloseButtonStyle}" Content="✕" Click="CloseBtn_Click" Margin="0,0,10,0" IsTabStop="False"/>
            </Grid>
            <Border Grid.Row="0" Height="1" Background="#14192A" VerticalAlignment="Bottom"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0D0F14" CornerRadius="0,0,0,12">
                    <Grid ClipToBounds="True">
                        <Border>
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Ressources/Icones/Bienvenue.png" Stretch="UniformToFill" AlignmentY="Top"/>
                            </Border.Background>
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0.25"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border Background="#CC0D0F14"/>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24">
                            <TextBlock Text="FROST" FontSize="30" FontWeight="Bold" Foreground="#8FEFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource TxtUninstallSubtitle}" FontSize="11" Foreground="#A0A5B5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="42,34,42,32">
                    <Grid x:Name="IntroPanel">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="36" Height="3" Background="#8FEFFF" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,22"/>
                            <TextBlock Text="{DynamicResource TxtUninstallTitle}" FontSize="24" FontWeight="Bold" Foreground="#E5E7EB" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource TxtUninstallDesc}" FontSize="13" Foreground="#8890A0" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,22"/>

                            <Border Background="#141820" BorderBrush="#252A38" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource TxtUninstallInternalFolderLabel}" Foreground="#8FEFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtInternalFolderPath" Foreground="#A0A5B5" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="ChkRemoveUserData" Style="{StaticResource UninstallCheckStyle}" IsChecked="True" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource TxtUninstallRemoveData}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{DynamicResource TxtUninstallRemoveDataHint}" Foreground="#5E667A" FontSize="11" TextWrapping="Wrap" Margin="32,0,0,24"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnCancel" Grid.Column="0" Content="{DynamicResource TxtUninstallCancel}" Style="{StaticResource UninstallSecondaryButtonStyle}" Click="BtnCancel_Click"/>
                                <Button x:Name="BtnUninstall" Grid.Column="2" Content="{DynamicResource TxtUninstallButton}" Style="{StaticResource UninstallPrimaryButtonStyle}" Click="BtnUninstall_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="36" Height="3" Background="#8FEFFF" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,22"/>
                            <TextBlock Text="{DynamicResource TxtUninstallProgressTitle}" FontSize="24" FontWeight="Bold" Foreground="#E5E7EB" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtUninstallStatus" Foreground="#8890A0" FontSize="13" Margin="0,0,0,34"/>
                            <ProgressBar x:Name="UninstallProgress" Style="{StaticResource UninstallProgressBarStyle}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtUninstallPercent" Text="0 %" Foreground="#4A5168" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FinishPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border x:Name="FinishIconCircle" Width="72" Height="72" CornerRadius="36" Background="#0C2018" BorderBrush="#22C55E" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <TextBlock x:Name="FinishIconText" Text="✓" FontSize="32" Foreground="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtFinishTitle" Text="{DynamicResource TxtUninstallCompleteTitle}" FontSize="22" FontWeight="Bold" Foreground="#E5E7EB" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtFinishDesc" Text="{DynamicResource TxtUninstallCompleteDesc}" FontSize="13" Foreground="#8890A0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,0,0,28"/>
                            <Button Content="{DynamicResource TxtUninstallClose}" Style="{StaticResource UninstallPrimaryButtonStyle}" Click="BtnCloseFinish_Click" MinWidth="150"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
