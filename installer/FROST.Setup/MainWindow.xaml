<Window x:Class="FROST.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST Setup"
        Width="960" Height="580"
        MinWidth="960" MinHeight="580"
        MaxWidth="960" MaxHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ── Checkbox ── -->
        <Style x:Key="ChkStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                                    Background="#2D303B" BorderBrush="#3A4055" BorderThickness="1.5"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock x:Name="chk" Text="✓" FontSize="11" FontWeight="Bold"
                                           Foreground="#8FEFFF" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#8FEFFF"/>
                                <Setter TargetName="box" Property="Background" Value="#0B2A32"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#54C8D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Language button ── -->
        <Style x:Key="LangBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2E3442"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8FEFFF"/>
                                <Setter TargetName="border" Property="Background" Value="#102A32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#153845"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button (Next / Install / Finish) ── -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#8FEFFF"/>
            <Setter Property="Foreground" Value="#0D0F14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B7FBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#54C8D8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1C3038"/>
                                <Setter Property="Foreground" Value="#5A8590"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button (Back) ── -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="BorderBrush" Value="#2E3442"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#23252E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A5168"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close button ── -->
        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A5168"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ── -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2D303B"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#2E3442"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#8FEFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#8FEFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Frost ProgressBar ── -->
        <Style x:Key="GoldProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#1E2230" CornerRadius="4" Height="8" x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" CornerRadius="4,0,0,4" Height="8"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8FEFFF" Offset="0"/>
                                        <GradientStop Color="#B7FBFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                      Color="#8FEFFF" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════ ROOT — drop shadow container ══════════ -->
    <Border CornerRadius="12" Background="#1B1F29" BorderBrush="#252A38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════════ SIDEBAR ════════════════ -->
            <Border Grid.Column="0" Background="#0D0F14" CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <!-- Artwork + FROST branding -->
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Border>
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Resources/Bienvenue.png"
                                            Stretch="UniformToFill" AlignmentY="Top"/>
                            </Border.Background>
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0.45"/>
                                    <GradientStop Color="Transparent" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <!-- Dim overlay for readability -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#440D0F14" Offset="0"/>
                                    <GradientStop Color="#CC0D0F14" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- FROST title pinned at bottom of artwork area -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="FROST" FontSize="30" FontWeight="Bold"
                                       Foreground="#8FEFFF" HorizontalAlignment="Center"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="TxtSubtitle" Text="Installateur"
                                       FontSize="11" Foreground="#A0A5B5"
                                       HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Border Grid.Row="0" Height="1" Background="#1A2030" VerticalAlignment="Bottom"/>

                    <!-- Steps list -->
                    <StackPanel Grid.Row="1" Margin="24,28,24,0" VerticalAlignment="Top">

                        <!-- Step 0 -->
                        <Grid x:Name="SideStep0" Margin="0,0,0,20" Cursor="Arrow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SideCircle0" Width="26" Height="26" CornerRadius="13"
                                    Background="#8FEFFF" HorizontalAlignment="Left">
                                <TextBlock x:Name="SideNum0" Text="1" FontSize="11" FontWeight="Bold"
                                           Foreground="#0D0F14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="SideLabel0" Grid.Column="1"
                                       Text="{DynamicResource SetupStepLang}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#8FEFFF"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Step 1 -->
                        <Grid x:Name="SideStep1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SideCircle1" Width="26" Height="26" CornerRadius="13"
                                    Background="#252A38" HorizontalAlignment="Left">
                                <TextBlock x:Name="SideNum1" Text="2" FontSize="11" FontWeight="Bold"
                                           Foreground="#4A5168" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="SideLabel1" Grid.Column="1"
                                       Text="{DynamicResource SetupStepWelcome}"
                                       FontSize="13" Foreground="#4A5168"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Step 2 -->
                        <Grid x:Name="SideStep2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SideCircle2" Width="26" Height="26" CornerRadius="13"
                                    Background="#252A38" HorizontalAlignment="Left">
                                <TextBlock x:Name="SideNum2" Text="3" FontSize="11" FontWeight="Bold"
                                           Foreground="#4A5168" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="SideLabel2" Grid.Column="1"
                                       Text="{DynamicResource SetupStepPath}"
                                       FontSize="13" Foreground="#4A5168"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Step 3 -->
                        <Grid x:Name="SideStep3" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SideCircle3" Width="26" Height="26" CornerRadius="13"
                                    Background="#252A38" HorizontalAlignment="Left">
                                <TextBlock x:Name="SideNum3" Text="4" FontSize="11" FontWeight="Bold"
                                           Foreground="#4A5168" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="SideLabel3" Grid.Column="1"
                                       Text="{DynamicResource SetupStepInstall}"
                                       FontSize="13" Foreground="#4A5168"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Step 4 -->
                        <Grid x:Name="SideStep4" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SideCircle4" Width="26" Height="26" CornerRadius="13"
                                    Background="#252A38" HorizontalAlignment="Left">
                                <TextBlock x:Name="SideNum4" Text="5" FontSize="11" FontWeight="Bold"
                                           Foreground="#4A5168" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="SideLabel4" Grid.Column="1"
                                       Text="{DynamicResource SetupStepFinish}"
                                       FontSize="13" Foreground="#4A5168"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                    </StackPanel>

                    <!-- Version -->
                    <TextBlock Grid.Row="2" Text="FROST v1.0.8  ·  © 2025"
                               FontSize="10" Foreground="#2A3040"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Right-side separator line -->
            <Border Grid.Column="0" Width="1" Background="#181D2A" HorizontalAlignment="Right"/>

            <!-- ════════════════ CONTENT ════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Title bar (drag + close) -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtWindowTitle"
                               Text="FROST — Installateur"
                               FontSize="11" Foreground="#303848"
                               VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <Button Grid.Column="1" Style="{StaticResource CloseBtnStyle}"
                            Content="✕" Click="CloseBtn_Click" Margin="0,0,10,0"
                            IsTabStop="False"/>
                </Grid>

                <!-- Separator under title bar -->
                <Border Grid.Row="0" Height="1" Background="#14192A" VerticalAlignment="Bottom"/>

                <!-- ── Step panels ── -->
                <Grid Grid.Row="1" Margin="44,36,44,0">

                    <!-- ─── STEP 0 : Langue ─── -->
                    <Grid x:Name="StepLang">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource LangTitle}"
                                   FontSize="22" FontWeight="SemiBold" Foreground="#E5E7EB"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource LangDesc}"
                                   FontSize="13" Foreground="#7A8090" TextWrapping="Wrap"/>
                        <WrapPanel Grid.Row="4" x:Name="LangGrid"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- ─── STEP 1 : Bienvenue ─── -->
                    <Grid x:Name="StepWelcome" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>
                        </Grid.ColumnDefinitions>

                        <!-- Text content -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,36,0">
                            <Border Width="36" Height="3" Background="#8FEFFF"
                                    HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,22"/>
                            <TextBlock Text="{DynamicResource WelcomeTitle}"
                                       FontSize="24" FontWeight="Bold" Foreground="#E5E7EB"
                                       TextWrapping="Wrap" FontFamily="Segoe UI" Margin="0,0,0,14"/>
                            <TextBlock Text="{DynamicResource WelcomeDesc}"
                                       FontSize="13" Foreground="#8890A0"
                                       TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,22"/>
                            <!-- Info badge -->
                            <Border Background="#141820" BorderBrush="#252A38" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="v1.0.8" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#8FEFFF"/>
                                    <TextBlock Text="   ·   Windows 10 / 11 x64" FontSize="12"
                                               Foreground="#4A5168"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Artwork -->
                        <Border Grid.Column="1" CornerRadius="10" Background="#11151D" Padding="10">
                            <Image Source="pack://application:,,,/Resources/Bienvenue.png"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>

                    <!-- ─── STEP 2 : Emplacement ─── -->
                    <Grid x:Name="StepPath" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="36" Height="3" Background="#8FEFFF"
                                    HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,22"/>
                            <TextBlock Text="{DynamicResource PathTitle}"
                                       FontSize="24" FontWeight="Bold" Foreground="#E5E7EB"
                                       FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource PathDesc}"
                                       FontSize="13" Foreground="#8890A0"
                                       TextWrapping="Wrap" Margin="0,0,0,30"/>

                            <!-- Path label -->
                            <TextBlock Text="{DynamicResource PathLabel}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#7A8090"
                                       Margin="0,0,0,8"/>

                            <!-- Path row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtPath" Style="{StaticResource InputStyle}"/>
                                <Button Grid.Column="2" x:Name="BtnBrowseBtn"
                                        Content="{DynamicResource BtnBrowse}"
                                        Style="{StaticResource SecondaryBtnStyle}"
                                        Click="BtnBrowse_Click"/>
                            </Grid>

                            <!-- Disk space pill -->
                            <Border Background="#141820" BorderBrush="#252A38" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8" Margin="0,0,0,24"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="13" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDiskSpace" FontSize="12"
                                               Foreground="#8890A0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Checkboxes -->
                            <CheckBox x:Name="ChkDesktop" Style="{StaticResource ChkStyle}"
                                      Content="{DynamicResource ChkDesktop}" IsChecked="True"
                                      Margin="0,0,0,12"/>
                            <CheckBox x:Name="ChkStartMenu" Style="{StaticResource ChkStyle}"
                                      Content="{DynamicResource ChkStartMenu}" IsChecked="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- ─── STEP 3 : Installation ─── -->
                    <Grid x:Name="StepInstall" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="36" Height="3" Background="#8FEFFF"
                                    HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,22"/>
                            <TextBlock Text="{DynamicResource InstallTitle}"
                                       FontSize="24" FontWeight="Bold" Foreground="#E5E7EB"
                                       FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtInstallStatus"
                                       FontSize="13" Foreground="#8890A0" Margin="0,0,0,36"/>

                            <!-- Progress bar + percentage -->
                            <ProgressBar x:Name="ProgressBarCtrl"
                                         Style="{StaticResource GoldProgressBar}"
                                         Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtPercent" Text="0 %"
                                       FontSize="11" Foreground="#4A5168"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- ─── STEP 4 : Terminé ─── -->
                    <Grid x:Name="StepFinish" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Success circle -->
                            <Border Width="72" Height="72" CornerRadius="36"
                                    Background="#0C2018" BorderBrush="#22C55E" BorderThickness="2"
                                    HorizontalAlignment="Center" Margin="0,0,0,24">
                                <TextBlock Text="✓" FontSize="32" Foreground="#22C55E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource FinishTitle}"
                                       FontSize="22" FontWeight="Bold" Foreground="#E5E7EB"
                                       HorizontalAlignment="Center" FontFamily="Segoe UI"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource FinishDesc}"
                                       FontSize="13" Foreground="#8890A0"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="360" Margin="0,0,0,28"/>
                            <CheckBox x:Name="ChkLaunch" Style="{StaticResource ChkStyle}"
                                      Content="{DynamicResource ChkLaunch}" IsChecked="True"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!-- ── Footer ── -->
                <Border Grid.Row="2" BorderBrush="#14192A" BorderThickness="0,1,0,0">
                    <Grid Margin="44,0">
                        <Button x:Name="BtnBack" Style="{StaticResource SecondaryBtnStyle}"
                                Content="{DynamicResource BtnBack}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="BtnBack_Click" Visibility="Hidden"/>
                        <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtnStyle}"
                                Content="{DynamicResource BtnNext}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="BtnNext_Click" IsEnabled="False"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
