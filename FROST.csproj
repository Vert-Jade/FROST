<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FROST</AssemblyName>
    <RootNamespace>FROST</RootNamespace>
    <Version>1.0.8</Version>
    <FileVersion>1.0.8.0</FileVersion>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <InformationalVersion>1.0.8</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>FROST</Product>
    <ApplicationIcon>Ressources\Icones\frost.ico</ApplicationIcon>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Ressources\Icones\frost.ico" />
    <!-- Inclut automatiquement TOUTES les images PNG (racine + sous-dossiers des thèmes) -->
    <Resource Include="Ressources\**\*.png" />
    <!-- On inclut aussi le dossier Icones s'il a été mis à la racine -->
    <Resource Include="Icones\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="installer\FROST.Setup\**\*.cs" />
    <Page Remove="installer\FROST.Setup\**\*.xaml" />
    <ApplicationDefinition Remove="installer\FROST.Setup\**\*.xaml" />
    <EmbeddedResource Remove="installer\FROST.Setup\**\*" />
    <None Remove="installer\FROST.Setup\**\*" />
    <Resource Remove="installer\FROST.Setup\**\*" />
  </ItemGroup>
</Project>
